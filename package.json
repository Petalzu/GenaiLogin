{
  "name": "genai-login",
  "displayName": "GENAI Login",
  "description": "UMPASS authentication and a local OpenAI-compatible bridge for University of Macau GENAI, with Copilot model configuration.",
  "readme": "GENAI-README.md",
  "version": "0.0.17",
  "publisher": "Petalzu",
  "author": "Petalzu",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Petalzu/GenaiLogin.git"
  },
  "homepage": "https://github.com/Petalzu/GenaiLogin#readme",
  "bugs": {
    "url": "https://github.com/Petalzu/GenaiLogin/issues"
  },
  "icon": "media/genai-icon.png",
  "keywords": ["genai", "umpass", "openai", "copilot", "authentication", "local-bridge"],
  "extensionKind": [
    "ui"
  ],
  "engines": {
    "vscode": "^1.110.0"
  },
  "categories": [
    "Other"
  ],
  "main": "./extension.js",
  "activationEvents": ["onStartupFinished"],
  "contributes": {
    "configuration": {
      "title": "GENAI Login",
      "properties": {
        "genai-login.port": {
          "type": "integer",
          "default": 58379,
          "minimum": 1024,
          "maximum": 65535,
          "scope": "application",
          "description": "Local bridge port. Reload participating windows after changing it and update your client's endpoint."
        },
        "genai-login.idleTimeoutSeconds": {
          "type": "integer",
          "default": 0,
          "minimum": 0,
          "maximum": 86400,
          "scope": "application",
          "description": "Upstream idle timeout in seconds; 0 disables it. Applies to new requests."
        }
      }
    },
    "viewsContainers": {
      "activitybar": [
        {
          "id": "genai-login",
          "title": "GENAI Login",
          "icon": "media/genai-activity.svg"
        }
      ]
    },
    "views": {
      "genai-login": [
        {
          "id": "genai-login.session",
          "name": "GENAI Login",
          "type": "webview"
        }
      ]
    },
    "commands": [
      {
        "command": "genai-login.port",
        "title": "GENAI Login: Set bridge port"
      },
      {
        "command": "genai-login.models",
        "title": "GENAI Login: Manage Copilot models"
      },
      {
        "command": "genai-login.connect",
        "title": "GENAI Login: Login and connect"
      },
      {
        "command": "genai-login.diagnose",
        "title": "GENAI Login: Diagnose login in visible Edge"
      },
      {
        "command": "genai-login.credentials",
        "title": "GENAI Login: Save account and password"
      },
      {
        "command": "genai-login.disconnect",
        "title": "GENAI Login: Disconnect"
      },
      {
        "command": "genai-login.clear",
        "title": "GENAI Login: Clear saved credentials and session"
      }
    ]
  },
  "scripts": {
    "lint": "eslint extension.js auth.js browser-auth.js dashboard.js stats.js bridge-stream.js copilot-config.js copilot-models.js test/extension.test.js test/stats.test.js test/bridge-stream.test.cjs test/local-access.test.cjs test/copilot-models.test.cjs",
    "pretest": "npm run lint",
    "test": "node --test test/*.test.cjs && vscode-test"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "24.x",
    "@types/vscode": "1.110.0",
    "@vscode/test-cli": "^0.0.15",
    "@vscode/test-electron": "^3.0.0",
    "@vscode/vsce": "^3.9.2",
    "eslint": "^10.5.0",
    "globals": "^17.12.0"
  },
  "overrides": {
    "diff": "^8.0.4",
    "serialize-javascript": "^7.0.6"
  },
  "dependencies": {
    "cheerio": "^1.2.0",
    "jsonc-parser": "^3.3.1",
    "playwright-core": "^1.63.0",
    "tough-cookie": "^6.0.2",
    "undici": "^7.30.0"
  }
}
